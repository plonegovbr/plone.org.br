<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonegovbr.portal"
    >

  <genericsetup:registerProfile
      name="default"
      title="Plone Brasil"
      description="Package to configure a new Plone Brasil site"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="initial"
      title="Plone Brasil: Conteúdo de exemplo"
      description="Create example content to showcase the new website"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/initial"
      pre_handler=".setuphandlers.initial.create_example_content"
      />

  <genericsetup:registerProfile
      name="oauth"
      title="Plone Brasil: Autenticação OAuth"
      description="Configura a autenticação via OAuth (GitHub)"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/oauth"
      />

  <!-- Hide Uninstall Profile-->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="plonegovbr.portal"
      />


  <include package=".upgrades" />

</configure>
