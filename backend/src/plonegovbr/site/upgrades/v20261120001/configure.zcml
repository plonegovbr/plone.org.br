<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    >

  <genericsetup:upgradeSteps
      profile="plonegovbr.site:default"
      source="20261113001"
      destination="20261120001"
      >
    <genericsetup:upgradeStep
        title="Atualiza o pas.plugins.identity para a versão 1014 do perfil"
        description="Registra os perfis core e contenttypes do pas.plugins.identity como instalados, sem importar nada"
        handler=".upgrade_identity"
        />
  </genericsetup:upgradeSteps>

</configure>
