    "6d16f183-95ab-43ea-bd97-a12fadf8f2f8": {
      "@type": "slate",
      "plaintext": " docker run : Inicie um novo container  --name plone6-frontend : Nomeie o novo container como plone6-frontend  --link plone6-backend:backend : Link (conecte) o container plone6-backend a este novo container, usando o nome de backend  -e RAZZLE_API_PATH= : Reescreva as chamadas de API utilizando este endere\u00e7o  -e RAZZLE_INTERNAL_API_PATH=http://backend:8080/Plone :  Internamente se comunique com o backend atrav\u00e9s deste endere\u00e7o  -d : Rode o container como um daemon (N\u00e3o bloqueia o terminal)  -p 3000:3000 : Disponibilize a porta 3000 do container (padr\u00e3o do servidor NodeJS) como porta 3000 no seu computador  plone/plone-frontend:latest : Utilize a image plone/plone-backend:latest para este container.",
      "value": [
        {
          "children": [
            {
              "children": [
                {
                  "text": ""
                },
                {
                  "children": [
                    {
                      "text": "docker run"
                    }
                  ],
                  "type": "strong"
                },
                {
                  "text": ": Inicie um novo container"
                }
              ],
              "type": "li"
            },
            {
              "children": [
                {
                  "text": ""
                },
                {
                  "children": [
                    {
                      "text": "--name plone6-frontend"
                    }
                  ],
                  "type": "strong"
                },
                {
                  "text": ": Nomeie o novo container como plone6-frontend"
                }
              ],
              "type": "li"
            },
            {
              "children": [
                {
                  "text": ""
                },
                {
                  "children": [
                    {
                      "text": "--link plone6-backend:backend"
                    }
                  ],
                  "type": "strong"
                },
                {
                  "text": " : Link (conecte) o container plone6-backend a este novo container, usando o nome de backend"
                }
              ],
              "type": "li"
            },
            {
              "children": [
                {
                  "text": ""
                },
                {
                  "children": [
                    {
                      "text": "-e RAZZLE_API_PATH="
                    }
                  ],
                  "type": "strong"
                },
                {
                  "text": ": Reescreva as chamadas de API utilizando este endere\u00e7o"
                }
              ],
              "type": "li"
            },
            {
              "children": [
                {
                  "text": ""
                },
                {
                  "children": [
                    {
                      "text": "-e RAZZLE_INTERNAL_API_PATH=http://backend:8080/Plone"
                    }
                  ],
                  "type": "strong"
                },
                {
                  "text": ":  Internamente se comunique com o backend atrav\u00e9s deste endere\u00e7o"
                }
              ],
              "type": "li"
            },
            {
              "children": [
                {
                  "text": ""
                },
                {
                  "children": [
                    {
                      "text": "-d"
                    }
                  ],
                  "type": "strong"
                },
                {
                  "text": ": Rode o container como um daemon (N\u00e3o bloqueia o terminal)"
                }
              ],
              "type": "li"
            },
            {
              "children": [
                {
                  "text": ""
                },
                {
                  "children": [
                    {
                      "text": "-p 3000:3000"
                    }
                  ],
                  "type": "strong"
                },
                {
                  "text": " : Disponibilize a porta 3000 do container (padr\u00e3o do servidor NodeJS) como porta 3000 no seu computador"
                }
              ],
              "type": "li"
            },
            {
              "children": [
                {
                  "text": ""
                },
                {
                  "children": [
                    {
                      "text": "plone/plone-frontend:latest"
                    }
                  ],
                  "type": "strong"
                },
                {
                  "text": " : Utilize a image "
                },
                {
                  "children": [
                    {
                      "text": "plone/plone-backend:latest"
                    }
                  ],
                  "data": {
                    "url": "https://hub.docker.com/r/plone/plone-frontend"
