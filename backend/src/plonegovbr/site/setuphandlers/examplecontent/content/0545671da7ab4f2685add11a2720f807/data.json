    "7016e933-66ef-4d34-a698-ab4027af8ecf": {
      "@type": "codeBlock",
      "code": "import '@plone/volto/config';\nimport Libras from '@plonegovbr/volto-vlibras/components/Libras';\n\nexport default function applyConfig(config) {\n\n  config.settings = {\n    ...config.settings,\n    appExtras: [\n      ...defaultSettings.appExtras,\n      {\n        match: '',\n        component: Libras,\n      },\n    ],\n  }\n\n  return config;\n  \n};",
      "language": "javascript",
      "showLineNumbers": true,
      "style": "dark",
      "wrapLongLines": true
    },
