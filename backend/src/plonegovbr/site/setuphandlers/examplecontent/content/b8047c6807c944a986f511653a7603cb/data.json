                {
                  "children": [
                    {
                      "text": "pytest-plone"
                    }
                  ],
                  "data": {
                    "url": "https://github.com/collective/pytest-plone"
                  },
                  "type": "link"
                },
                {
                  "text": ", para os testes automatizados do Backend/API"
