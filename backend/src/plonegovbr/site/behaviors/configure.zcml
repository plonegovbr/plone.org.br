<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="plonegovbr.site"
    >

  <include
      package="plone.behavior"
      file="meta.zcml"
      />

  <plone:behavior
      name="plonegovbr.site.affiliations"
      title="Affiliations"
      description="Relate a profile to one or more Organizations"
      provides=".affiliations.IAffiliations"
      />

</configure>
